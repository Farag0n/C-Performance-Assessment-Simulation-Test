@model IEnumerable<SkyTravel.Models.User>
<h1>Lista de usuarios registrados</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Registrar usuario</a>
    <a asp-controller="Principal" asp-action="Index" class="btn btn-secondary">Volver al menu principal</a>
</p>

<table class="table table-striped">
    <thead>
        <tr class="table-dark">
            <th>ID</th>
            <th>Nombre</th>
            <th>Numero de documento</th>
            <th>Correo</th>
            <th>Numero celular</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td class="table-light">@user.Id</td>
            <td>@user.Name</td>
            <td>@user.DocNumber</td>
            <td>@user.Email</td>
            <td>@user.CelNumber</td>
            <td>
                <a asp-controller="User" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-warning btn-sm">Editar</a>
            </td>
            <td>
                <form asp-controller="User" asp-action="Delete" asp-route-id="@user.Id" method="post" onsubmit="return confirm('¿Seguro que deseas eliminar este usuario?');">
                    <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
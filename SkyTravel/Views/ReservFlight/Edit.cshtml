@model SkyTravel.Models.ReservFlight

<div class="card p-4 shadow-lg" style="max-width: 800px; margin: 2rem auto;">
    <div class="d-flex flex-wrap align-items-start">
        <div style="flex: 1;">
            <h3 class="mb-3">Editar Reserva</h3>

            <form asp-action="Edit" asp-controller="ReservFlight" method="post">
                <input type="hidden" asp-for="Id" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="FlightId" class="form-label fw-bold">Vuelo</label>
                    <select asp-for="FlightId" asp-items="ViewBag.Flights" class="form-select"></select>
                    <span asp-validation-for="FlightId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="UserId" class="form-label fw-bold">Pasajero</label>
                    <select asp-for="UserId" asp-items="ViewBag.Users" class="form-select"></select>
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Pay" class="form-label fw-bold">Estado del pago</label>
                    <select asp-for="Pay" asp-items="Html.GetEnumSelectList<SkyTravel.Models.ReservFlight.PayStatus>()" class="form-select">
                        <option value="">Selecciona el estado</option>
                    </select>
                    <span asp-validation-for="Pay" class="text-danger"></span>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success me-2">Guardar cambios</button>
                    <a href="@Url.Action("Index", "ReservFlight")" class="btn btn-secondary">Volver</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

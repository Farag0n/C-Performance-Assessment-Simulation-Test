@model SkyTravel.Models.ReservFlight

<h1>Reservar vuelo</h1>

<div class="card p-4 shadow-lg" style="max-width: 800px; margin: 2rem auto;">
    <div class="d-flex flex-wrap align-items-start">
        <div style="flex: 1;">
            <h3 class="mb-3">Reservar vuelo</h3>

            <form asp-action="Create" asp-controller="ReservFlight" method="post">
                <!-- Seleccionar vuelo -->
                <div class="mb-3">
                    <label asp-for="FlightId" class="form-label fw-bold">Selecciona un vuelo</label>
                    <select asp-for="FlightId" asp-items="ViewBag.Flights" class="form-select">
                        <option value="">-- Seleccione un vuelo --</option>
                    </select>
                    <span asp-validation-for="FlightId" class="text-danger"></span>
                </div>

                <!-- Seleccionar usuario -->
                <div class="mb-3">
                    <label asp-for="UserId" class="form-label fw-bold">Selecciona un pasajero</label>
                    <select asp-for="UserId" asp-items="ViewBag.Users" class="form-select">
                        <option value="">-- Seleccione un pasajero --</option>
                    </select>
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>

                <!-- Mostrar mensajes de error -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <div class="mt-4">
                    <button type="submit" class="btn btn-success me-2">Reservar</button>
                    <a href="@Url.Action("Index", "ReservFlight")" class="btn btn-secondary">Volver</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
